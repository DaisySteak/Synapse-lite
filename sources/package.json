{
    "$schema": "https://www.schemastore.org/package.json",
    "name": "synapse-lite",
    "version": "1.10.2",
    "private": true,
    "type": "module",
    "description": "Synapse Lite — gestion des tickets de l'équipe dans un dossier partagé, en un seul fichier HTML",
    "engines": {
        "node": ">=18.0.0"
    },
    "scripts": {
        "dev": "vite",
        "build": "vite build && node scripts/publish.mjs",
        "init-data": "vite-node scripts/init-data.ts",
        "demo-data": "vite-node scripts/demo-data.ts",
        "type-check": "vue-tsc --noEmit -p tsconfig.json",
        "lint": "eslint --ext .ts,.vue src tests",
        "format": "prettier --write \"src/**/*.{ts,vue,css}\" \"tests/**/*.ts\" \"scripts/**/*.{ts,mjs}\"",
        "format:check": "prettier --check \"src/**/*.{ts,vue,css}\" \"tests/**/*.ts\" \"scripts/**/*.{ts,mjs}\"",
        "test": "vitest run",
        "check": "npm run type-check && npm run lint && npm run format:check && npm run test"
    },
    "dependencies": {
        "@fontsource/source-sans-3": "5.3.1",
        "dompurify": "3.4.17",
        "marked": "15.0.12",
        "pinia": "3.0.4",
        "vue": "3.5.45",
        "vue-router": "4.6.4"
    },
    "devDependencies": {
        "@types/node": "^18.19.130",
        "@typescript-eslint/eslint-plugin": "6.21.0",
        "@typescript-eslint/parser": "6.21.0",
        "@vitejs/plugin-vue": "5.2.4",
        "eslint": "8.57.1",
        "eslint-plugin-vue": "9.33.0",
        "jsdom": "25.0.1",
        "prettier": "3.10.0",
        "typescript": "5.6.3",
        "vite": "5.4.21",
        "vite-plugin-singlefile": "2.0.3",
        "vitest": "2.1.9",
        "vue-eslint-parser": "9.4.3",
        "vue-tsc": "2.2.12"
    }
}
